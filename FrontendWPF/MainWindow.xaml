<Window x:Class="FrontendWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FrontendWPF.ViewModels"
        xmlns:views="clr-namespace:FrontendWPF.Views"
        Title="Dragon Ball - Cliente WPF"
        Height="640" Width="1100"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Cada ViewModel se pinta con su vista -->
        <DataTemplate DataType="{x:Type vm:ConfiguracionViewModel}">
            <views:ConfiguracionView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PersonajesViewModel}">
            <views:PersonajesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConsultaViewModel}">
            <views:ConsultaView/>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Left" Width="190" Background="#FF2B2B2B" Padding="12">
            <StackPanel>
                <TextBlock Text="Dragon Ball" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding Usuario}" Foreground="#FFBBBBBB" Margin="0,0,0,20"/>

                <Button Content="Configuración" Command="{Binding MostrarConfiguracionCommand}" Padding="8" Margin="0,0,0,8"/>
                <Button Content="Personajes" Command="{Binding MostrarPersonajesCommand}" Padding="8" Margin="0,0,0,8"/>
                <Button Content="Consulta MCP" Command="{Binding MostrarConsultaCommand}" Padding="8" Margin="0,0,0,8"/>
            </StackPanel>
        </Border>

        <ContentControl Content="{Binding VistaActual}"/>
    </DockPanel>
</Window>
