<UserControl x:Class="FrontendWPF.Views.PersonajesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top" Text="Personajes (vista Master)" FontSize="22" FontWeight="Bold" Margin="0,0,0,10"/>

        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                <TextBlock Text="Nombre"/>
                <TextBox Text="{Binding FiltroNombre, UpdateSourceTrigger=PropertyChanged}" Padding="3"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,6,0">
                <TextBlock Text="Saga o película"/>
                <TextBox Text="{Binding FiltroSaga, UpdateSourceTrigger=PropertyChanged}" Padding="3"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,6,0">
                <TextBlock Text="Serie"/>
                <TextBox Text="{Binding FiltroSerie, UpdateSourceTrigger=PropertyChanged}" Padding="3"/>
            </StackPanel>
            <Button Grid.Column="3" Content="Buscar" Command="{Binding BuscarCommand}" VerticalAlignment="Bottom" Padding="14,4"/>
        </Grid>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Cargar más" Command="{Binding CargarMasCommand}" Padding="12,5"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Nuevo..." Command="{Binding NuevoCommand}" Padding="12,5" Margin="0,0,8,0"/>
                    <Button Content="Editar..." Command="{Binding EditarCommand}" Padding="12,5" Margin="0,0,8,0"/>
                    <Button Content="Eliminar" Command="{Binding EliminarCommand}" Padding="12,5"/>
                </StackPanel>
            </DockPanel>
            <TextBlock Text="{Binding Resumen}" Margin="0,10,0,0"/>
            <TextBlock Text="{Binding Estado}" Margin="0,4,0,0"/>
        </StackPanel>

        <DataGrid ItemsSource="{Binding Personajes}"
                  SelectedItem="{Binding Seleccionado, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  EnableRowVirtualization="True">
            <DataGrid.InputBindings>
                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding EditarCommand}"/>
            </DataGrid.InputBindings>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="60"/>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="2*"/>
                <DataGridTextColumn Header="Nivel de poder" Binding="{Binding NivelDePoder, StringFormat=N0}" Width="*"/>
                <DataGridTextColumn Header="Saga o película" Binding="{Binding SagaOPelicula}" Width="*"/>
                <DataGridTextColumn Header="Serie" Binding="{Binding Serie}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
