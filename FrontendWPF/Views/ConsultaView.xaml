<UserControl x:Class="FrontendWPF.Views.ConsultaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top" Text="Consulta con MCP" FontSize="22" FontWeight="Bold" Margin="0,0,0,12"/>

        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding Pregunta, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,8,0">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding EnviarCommand}"/>
                </TextBox.InputBindings>
            </TextBox>
            <Button Grid.Column="1" Content="Enviar" Command="{Binding EnviarCommand}" Padding="16,6"/>
        </Grid>

        <ListBox ItemsSource="{Binding Mensajes}" HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2,4">
                        <TextBlock Text="{Binding Autor}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Texto}" TextWrapping="Wrap"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
